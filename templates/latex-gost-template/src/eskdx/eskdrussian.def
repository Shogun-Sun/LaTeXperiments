% --------------------------------------------------------------------------
% Russian alphabetical numbering
%
% Original eskdx used legacy \CYR... and \cyr... commands.
% Use Unicode characters under XeLaTeX.
% --------------------------------------------------------------------------

\def\@Asbuk#1{%
  \ifcase#1
  \or А\or Б\or В\or Г\or Д\or Е\or Ж\or
  З\or И\or К\or Л\or М\or Н\or
  О\or П\or Р\or С\or Т\or У\or Ф\or Х\or
  Ц\or Ч\or Ш\or Щ\or Ъ\or Ы\or Ь\or
  Э\or Ю\or Я%
  \else
    {\@tempcnta \number #1\relax
     \advance\@tempcnta -33\relax
     \protect\number\@tempcnta}%
  \fi}

\def\@asbuk#1{%
  \ifcase#1
  \or а\or б\or в\or г\or д\or е\or ж\or
  з\or и\or к\or л\or м\or н\or
  о\or п\or р\or с\or т\or у\or ф\or х\or
  ц\or ч\or ш\or щ\or ъ\or ы\or ь\or
  э\or ю\or я%
  \else
    {\@tempcnta \number #1\relax
     \advance\@tempcnta -33\relax
     \protect\number\@tempcnta}%
  \fi}