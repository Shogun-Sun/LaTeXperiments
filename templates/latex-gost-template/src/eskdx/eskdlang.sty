\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{eskdlang}[2026/10/03 v0.98-xetex Language]

\newcommand{\ESKD@lang}{russian}

\newif\ifESKD@given@encoding
\ESKD@given@encodingfalse

\DeclareOption{russian}{%
    \renewcommand{\ESKD@lang}{russian}}

\DeclareOption{ukrainian}{%
    \renewcommand{\ESKD@lang}{ukrainian}}

\DeclareOption*{%
    \PassOptionsToPackage{\CurrentOption}{inputenc}%
    \ESKD@given@encodingtrue}

\ProcessOptions\relax

\ifdefined\XeTeXversion
% XeLaTeX: Unicode + polyglossia.
\else\ifdefined\directlua
% LuaLaTeX: Unicode + polyglossia.
\else
  % Original pdfLaTeX behaviour.
\ifESKD@given@encoding
\RequirePackage{inputenc}
\fi
\RequirePackage[\ESKD@lang]{babel}
\fi\fi

\input{eskd\ESKD@lang.def}